# ─── Database — Supabase (Postgres + pgvector) ───────────────────────────────
# REQUIRED. Read by BOTH the API and the Worker (SQLAlchemy).
# Use the Supabase connection pooler for containers/serverless:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ─── Supabase Storage — document files ──────────────────────────────────────
# REQUIRED. Read by BOTH the API (uploads bytes) and the Worker (downloads bytes).
# Project URL + service-role key from Supabase -> Project Settings -> API.
# Create a private Storage bucket named "documents".
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Redis broker — Upstash (serverless Redis) ───────────────────────────────
# REQUIRED. Celery broker + result backend. Read by BOTH the API (to enqueue)
# and the Worker (to consume). Upstash endpoints are TLS:
#   rediss://default:<password>@<region>.upstash.io:6379
# Celery over TLS may need the query suffix: ?ssl_cert_reqs=required
REDIS_URL=rediss://default:password@host:6379

# ─── Gemini API (google-genai SDK) ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
CHAT_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-2

# ─── Auth ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API — set to your Vercel URL(s).
# "*" is accepted for local development only (credentials are disabled in that mode).
FRONTEND_ORIGINS=https://your-frontend.vercel.app
